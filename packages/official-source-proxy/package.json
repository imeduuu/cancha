{
  "name": "@cancha/official-source-proxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Proxy cerrado de las fuentes oficiales sin CORS (ANFP, ANFA, Copa Argentina, CBF): sólo Node, sin Nest ni Express.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "0.23.7",
    "typescript": "~5.7.2",
    "vitest": "^5.0.4"
  }
}
