# Copia este archivo a apps/api/.env y ajusta los valores.
# La API valida todo al arrancar y no inicia si algo es inválido.

# development | test | production (por defecto: development)
NODE_ENV=development

# Puerto HTTP de la API (por defecto: 3000)
PORT=3000

# Obligatoria. Debe apuntar a un replica set: la persistencia usa transacciones.
# Con `npm run db:up` (docker-compose.yml de la raíz):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Base de datos de Cancha (por defecto: cancha)
MONGODB_DB=cancha

# ---------- Autenticación (fase 4) ----------

# Secreto HS256 de los access tokens: al menos 32 caracteres aleatorios.
# Obligatorio en producción. En development/test, si falta, se usa un valor
# inseguro conocido. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=

# Orígenes que pueden llamar a la API con credenciales (CORS y cookie del
# refresh token), separados por comas, sin ruta ni barra final. Obligatorio en
# producción. Por defecto (fuera de producción): Vite en 127.0.0.1:5173 y localhost:5173.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Cookie HttpOnly del refresh token (Path=/graphql).
# SameSite: lax (por defecto; web y API en el mismo sitio u origen), strict o none
# (none exige Secure). Secure: true por defecto; false sólo fuera de producción.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true

# Vida del refresh token en días (se renueva en cada rotación). Por defecto: 30.
# REFRESH_TOKEN_TTL_DAYS=30

# Rate limit de register, login y refreshToken: intentos por IP y operación por ventana.
# AUTH_RATE_LIMIT=10
# AUTH_RATE_TTL_SECONDS=60

# Saltos de proxy confiables (trust proxy de Express) para ver la IP real del
# cliente detrás de un balanceador: el número de proxies PROPIOS entre el cliente
# y la API. Sólo un entero de 0 a 10, nunca true. 0 = conexión directa.
# Lo usan el rate limit de auth y el de fuentes oficiales.
# Ver docs/deployment.md (valores para Vercel/Render y cómo verificarlos).
# TRUST_PROXY=0

# Diagnóstico temporal para verificar TRUST_PROXY tras un despliegue: con true,
# cada petición registra X-Forwarded-For, la IP del socket y req.ip. Las IPs son
# datos personales: vuelve a false (o borra la variable) apenas termines.
# Ver docs/deployment.md. Por defecto: false.
# LOG_CLIENT_IP=false

# ---------- Fuentes oficiales (fase 6) ----------
# Proxy cerrado de ANFP, ANFA, Copa Argentina y CBF (rutas públicas
# /official-source, /third-division-source, /argentina-cup-source y
# /brazil-cup-source). Destinos fijos en el código. Ver docs/official-source-proxy.md.

# Plazo por consulta al origen, incluidas redirecciones y lectura (ms).
# OFFICIAL_SOURCE_TIMEOUT_MS=20000
# Tamaño máximo de una respuesta ya descomprimida (bytes; 5 MiB).
# OFFICIAL_SOURCE_MAX_BYTES=5242880
# Caché en memoria por URL: vida en segundos (0 la desactiva), entradas y bytes.
# OFFICIAL_SOURCE_CACHE_TTL_SECONDS=600
# OFFICIAL_SOURCE_CACHE_MAX_ENTRIES=200
# OFFICIAL_SOURCE_CACHE_MAX_BYTES=67108864
# Consultas por IP en cada ventana (también cuentan los aciertos de caché).
# OFFICIAL_SOURCE_RATE_LIMIT=300
# OFFICIAL_SOURCE_RATE_TTL_SECONDS=60
