# Copia este archivo a apps/api/.env y ajusta los valores.
# La API valida todo al arrancar y no inicia si algo es inválido.

# development | test | production (por defecto: development)
NODE_ENV=development

# Puerto HTTP de la API (por defecto: 3000)
PORT=3000

# Obligatoria. Debe apuntar a un replica set: la persistencia usa transacciones.
# Con `npm run db:up` (docker-compose.yml de la raíz):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Base de datos de Cancha (por defecto: cancha)
MONGODB_DB=cancha

# ---------- Autenticación (fase 4) ----------

# Secreto HS256 de los access tokens: al menos 32 caracteres aleatorios.
# Obligatorio en producción. En development/test, si falta, se usa un valor
# inseguro conocido. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=

# Orígenes que pueden llamar a la API con credenciales (CORS y cookie del
# refresh token), separados por comas, sin ruta ni barra final. Obligatorio en
# producción. Por defecto (fuera de producción): Vite en 127.0.0.1:5173 y localhost:5173.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Cookie HttpOnly del refresh token (Path=/graphql).
# SameSite: lax (por defecto; web y API en el mismo sitio u origen), strict o none
# (none exige Secure). Secure: true por defecto; false sólo fuera de producción.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true

# Vida del refresh token en días (se renueva en cada rotación). Por defecto: 30.
# REFRESH_TOKEN_TTL_DAYS=30

# Rate limit de register, login y refreshToken: intentos por IP y operación por ventana.
# AUTH_RATE_LIMIT=10
# AUTH_RATE_TTL_SECONDS=60

# Saltos de proxy confiables (trust proxy de Express) para ver la IP real del
# cliente detrás de un balanceador. 0 = conexión directa.
# TRUST_PROXY=0
