# Copia este archivo a apps/api/.env y ajusta los valores.
# La API valida todo al arrancar y no inicia si algo es inválido.

# development | test | production (por defecto: development)
NODE_ENV=development

# Puerto HTTP de la API (por defecto: 3000)
PORT=3000

# Obligatoria. Debe apuntar a un replica set: la persistencia usa transacciones.
# Con `npm run db:up` (docker-compose.yml de la raíz):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Base de datos de Cancha (por defecto: cancha)
MONGODB_DB=cancha
