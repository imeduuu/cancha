{
  "name": "@cancha/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API de Cancha (NestJS + MongoDB) sobre @cancha/core compilado.",
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.38"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "tsc -p tsconfig.spec.json && vitest run"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@cancha/core": "*",
    "@nestjs/apollo": "14.1.2",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/graphql": "14.1.2",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "graphql": "16.14.2",
    "mongodb": "7.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server-core": "11.3.0",
    "supertest": "7.3.1",
    "typescript": "~5.7.2",
    "vitest": "^5.0.4"
  }
}
