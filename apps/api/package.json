{
  "name": "@cancha/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API de Cancha (NestJS + MongoDB) sobre @cancha/core compilado.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "tsc -p tsconfig.spec.json && vitest run"
  },
  "dependencies": {
    "@cancha/core": "*",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "mongodb": "7.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.7.2",
    "vitest": "^5.0.4"
  }
}
