{
  "name": "@cancha/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca ../../node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "node --use-system-ca ../../node_modules/vite/bin/vite.js preview",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "verify:live": "node --use-system-ca scripts/verify-live-importers.mjs",
    "test:flows": "vitest run src/presentation/app.test.tsx src/presentation/app-lazy.test.tsx src/presentation/app-journeys.test.tsx src/presentation/app-competitions.test.tsx src/presentation/components/deferred-panel.test.tsx src/presentation/app-checkpoints.test.tsx src/presentation/app-closure.test.tsx src/presentation/app-archive.test.tsx src/presentation/app-draws.test.tsx src/presentation/app-decisions.test.tsx",
    "dev:public": "node --use-system-ca scripts/dev-public.mjs",
    "test:e2e": "tsc -p tsconfig.e2e.json && node --conditions=source ../../node_modules/@playwright/test/cli.js test",
    "test:e2e:session": "tsc -p tsconfig.e2e.json && node --conditions=source ../../node_modules/@playwright/test/cli.js test -c playwright.session.config.mjs"
  },
  "dependencies": {
    "@cancha/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cancha/official-source-proxy": "*",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "graphql": "16.14.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
