{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci -w @cancha/web",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/graphql(/)?", "destination": "https://cancha-api-i4yx.onrender.com/graphql" },
    { "source": "/official-source(/.*)?", "destination": "https://cancha-api-i4yx.onrender.com/official-source$1" },
    { "source": "/third-division-source(/.*)?", "destination": "https://cancha-api-i4yx.onrender.com/third-division-source$1" },
    { "source": "/argentina-cup-source(/.*)?", "destination": "https://cancha-api-i4yx.onrender.com/argentina-cup-source$1" },
    { "source": "/brazil-cup-source(/.*)?", "destination": "https://cancha-api-i4yx.onrender.com/brazil-cup-source$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
