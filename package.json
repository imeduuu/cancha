{
  "name": "cancha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @cancha/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:flows": "npm run test:flows -w @cancha/web",
    "test:e2e": "npm run test:e2e -w @cancha/web",
    "lint": "eslint .",
    "preview": "npm run preview -w @cancha/web",
    "analyze:bundle": "npm run analyze:bundle -w @cancha/web",
    "verify:live": "npm run verify:live -w @cancha/web",
    "dev:public": "npm run dev:public -w @cancha/web"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.72.1"
  }
}
